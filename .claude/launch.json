{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Recipe site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["scripts/dev.py"],
      "port": 8000,
      // Falls back to another port when 8000 is taken (dev.py reads PORT).
      // Google sign-in only works on http://localhost:8000.
      "autoPort": true
    }
  ]
}
